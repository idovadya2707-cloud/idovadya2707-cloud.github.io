---
// סקשן 6 — שלושה צעדים וסגרתם (רצועה קומפקטית, 3 צעדים)
const steps = [
  { n: 1, title: 'שולחים הודעה', body: 'כמה אנשים ואיזה חודש' },
  { n: 2, title: 'מדברים', body: 'עידו חוזר אליכם עם תאריכים והצעה' },
  { n: 3, title: 'סוגרים תאריך', body: 'חוזה קצר וזהו' },
];
---

<section class="px-5 py-12 sm:py-14">
  <div class="mx-auto max-w-5xl">
    <h2 class="text-center text-2xl font-bold leading-tight sm:text-3xl md:text-4xl">
      שלושה צעדים וסגרתם
    </h2>

    <ol class="mt-8 grid gap-6 sm:grid-cols-3 sm:gap-8">
      {steps.map((s) => (
        <li>
          <div class="flex items-center gap-3">
            <span
              class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-gold bg-gold/10 font-heading text-sm font-bold text-gold"
              aria-hidden="true"
            >
              {s.n}
            </span>
            <h3 class="text-lg font-bold sm:text-xl">{s.title}</h3>
          </div>
          <p class="mt-1 ps-11 text-sm leading-snug text-ink/70 sm:text-base">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
