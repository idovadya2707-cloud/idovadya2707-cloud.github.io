---
// סקשן 6 — איך זה עובד
const steps = [
  { n: 1, title: 'שולחים הודעה', body: 'כמה אנשים, ואיזה חודש בערך' },
  { n: 2, title: 'מקבלים הצעה', body: 'מחיר לאדם, תאריכים פנויים, הכל בכתב' },
  { n: 3, title: 'מגיעים לראות', body: 'בשעת השקיעה, כדי להבין למה זה עובד' },
  { n: 4, title: 'סוגרים תאריך', body: 'חוזה, מקדמה, וזהו' },
];
---

<section class="px-5 py-20 sm:py-28">
  <div class="mx-auto max-w-5xl">
    <h2 class="text-center text-3xl font-bold leading-tight sm:text-4xl md:text-5xl">
      איך זה עובד
    </h2>

    <ol class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((s) => (
        <li class="flex flex-col gap-4">
          <span
            class="flex h-14 w-14 items-center justify-center rounded-full border border-gold bg-gold/10 font-heading text-2xl font-bold text-gold"
            aria-hidden="true"
          >
            {s.n}
          </span>
          <div>
            <h3 class="text-xl font-bold sm:text-2xl">{s.title}</h3>
            <p class="mt-2 text-base leading-relaxed text-ink/75">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
