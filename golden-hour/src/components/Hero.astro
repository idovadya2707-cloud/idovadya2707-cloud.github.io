---
import SunLogo from './SunLogo.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { CTA } from '../config';
---

<section class="relative min-h-[100svh] flex flex-col overflow-hidden">
  <!-- וידאו רקע: ניגון אוטומטי, בלולאה, מושתק. תמונת poster כגיבוי מיידי -->
  <video
    id="hero-video"
    class="absolute inset-0 h-full w-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster="/images/hero.webp"
    aria-hidden="true"
  >
    <source src="/videos/hero.mp4" type="video/mp4" />
  </video>
  <!-- overlay כהה קל -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-ink/40 via-ink/25 to-ink/70"
    aria-hidden="true"
  ></div>

  <!-- לוגו חתימה למעלה -->
  <header class="relative z-10 flex justify-center pt-8">
    <SunLogo tone="dark" />
  </header>

  <!-- תוכן ה-Hero -->
  <div class="relative z-10 flex flex-1 flex-col items-center justify-center px-5 pb-16 text-center">
    <h1 class="max-w-4xl text-balance text-5xl font-extrabold leading-[1.1] text-cream sm:text-6xl md:text-7xl">
      האורחים שלכם לא ישכחו את הערב הזה.
    </h1>

    <p class="mt-7 max-w-2xl text-balance text-xl leading-relaxed text-cream/90 sm:text-2xl">
      מתחם אירועים על הגג, מול הים בתל אביב. אירועי חברה, ימי הולדת ומסיבות פרטיות.
    </p>

    <div class="mt-9 flex justify-center">
      <WhatsAppButton href={CTA.primary} section="hero_primary" variant="primary">
        בדקו תאריכים פנויים
      </WhatsAppButton>
    </div>
  </div>

  <!-- סנטינל לזיהוי יציאה מה-Hero (לסרגל ה-CTA הדביק) -->
  <div id="hero-sentinel" class="absolute bottom-0 h-px w-full" aria-hidden="true"></div>

  <script is:inline>
    (function () {
      var v = document.getElementById('hero-video');
      if (!v) return;
      v.muted = true; // הבטחת השתקה לצורך ניגון אוטומטי
      // כיבוד העדפת המשתמש להפחתת אנימציות — משאיר את ה-poster ללא ניגון
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        v.removeAttribute('autoplay');
        v.pause();
        return;
      }
      var p = v.play();
      if (p && p.catch) p.catch(function () {});
    })();
  </script>
</section>
