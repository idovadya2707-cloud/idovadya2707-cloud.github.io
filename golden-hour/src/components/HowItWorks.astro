---
// סקשן 6 — שלושה צעדים וסגרתם (רצועה מועשרת: אייקון + מספר + כותרת + שורה)
import WhatsAppButton from './WhatsAppButton.astro';
import { CTA } from '../config';

const steps = [
  {
    n: 1,
    title: 'שולחים הודעה',
    body: 'כמה אנשים ואיזה חודש',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5 8.6 8.6 0 0 1-3.9-.9L3 21l1.9-5.6a8.5 8.5 0 1 1 16.1-3.9z"/></svg>`,
  },
  {
    n: 2,
    title: 'מדברים',
    body: 'עידו חוזר אליכם עם תאריכים והצעה',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2 4.2 2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L8 9.6a16 16 0 0 0 6 6l1.2-1.1a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2z"/></svg>`,
  },
  {
    n: 3,
    title: 'סוגרים תאריך',
    body: 'חוזה קצר וזהו',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M9 16l2 2 4-4"/></svg>`,
  },
];
---

<section class="px-5 py-16 sm:py-20">
  <div class="mx-auto max-w-5xl">
    <h2 class="text-center text-2xl font-bold leading-tight sm:text-3xl md:text-4xl">
      שלושה צעדים וסגרתם
    </h2>

    <ol class="mt-10 grid gap-5 sm:grid-cols-3 sm:gap-6">
      {steps.map((s) => (
        <li class="flex flex-col items-center rounded-2xl border border-gold/25 bg-white/60 p-6 text-center shadow-sm">
          <span class="flex h-14 w-14 items-center justify-center rounded-full bg-gold/10 text-gold" aria-hidden="true">
            <Fragment set:html={s.icon} />
          </span>
          <div class="mt-4 flex items-center justify-center gap-2">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-gold text-xs font-bold text-cream" aria-hidden="true">{s.n}</span>
            <h3 class="text-lg font-bold sm:text-xl">{s.title}</h3>
          </div>
          <p class="mt-2 text-sm leading-snug text-ink/70 sm:text-base">{s.body}</p>
        </li>
      ))}
    </ol>

    <div class="mt-10 flex justify-center">
      <WhatsAppButton href={CTA.primary} section="steps_cta" variant="primary">
        בדקו תאריכים פנויים
      </WhatsAppButton>
    </div>
  </div>
</section>
