---
// סקשן 5 — מה כלול
const items = [
  { text: 'בר פתוח מלא: בירה, יין, אלכוהול וקוקטיילים' },
  { text: 'צוות ברמנים ומלצרים' },
  { text: 'מערכת הגברה ותאורה במקום' },
  { text: 'עמדת DJ מחוברת ומוכנה', dj: true },
  { text: 'ריהוט מלא: עמדות בר, שולחנות וישיבה' },
  { text: 'צוות ניקיון לאורך כל האירוע' },
  { text: 'המתחם כולו סגור ופרטי' },
];
---

<section class="bg-ink px-5 py-20 text-cream sm:py-28">
  <div class="mx-auto max-w-4xl">
    <h2 class="text-3xl font-bold leading-tight sm:text-4xl md:text-5xl">
      מה נכנס בחבילה
    </h2>

    <ul class="mt-12 grid gap-x-10 gap-y-5 sm:grid-cols-2">
      {items.map((it) => (
        <li class="flex items-start gap-3">
          <svg
            class="mt-1 h-5 w-5 shrink-0 text-gold-light"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 111.4-1.4l3.3 3.3 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd" />
          </svg>
          <span class="text-lg leading-relaxed text-cream/90">
            {it.dj ? (<>עמדת <span dir="ltr">DJ</span> מחוברת ומוכנה</>) : it.text}
          </span>
        </li>
      ))}
    </ul>

    <!-- תוספות אופציונליות -->
    <div class="mt-12 rounded-2xl border border-gold/40 bg-white/5 p-6 sm:p-8">
      <h3 class="text-xl font-bold text-gold-light sm:text-2xl">תוספות אופציונליות</h3>
      <p class="mt-3 text-lg leading-relaxed text-cream/85">
        מגשי פירות, גבינות משובחות, מטוגנים ופינוקים, ותחנת טאבון חיה לפיצות ופוקאצ'ות.
      </p>
    </div>
  </div>
</section>
