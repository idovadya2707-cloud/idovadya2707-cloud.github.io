---
// סקשן 4 — גלריה (קרוסלה חלקה מבוססת scroll-snap, תמונה אחת בכל פעם)
const shots = [
  { src: '/images/gallery-3.webp', caption: 'ישיבה ואירוח לקבוצות' },
  { src: '/images/gallery-1.webp', caption: 'הבר, רגע לפני השקיעה' },
  { src: '/images/gallery-2.webp', caption: 'המתחם בשעת האירוע' },
];
const captions = shots.map((s) => s.caption);
---

<section class="px-5 py-20 sm:py-28">
  <div class="mx-auto max-w-md">
    <h2 class="text-center text-3xl font-bold leading-tight sm:text-4xl md:text-5xl">
      ככה נראה ערב אצלנו
    </h2>

    <figure class="mt-12">
      <div class="relative">
        <div
          id="gh-track"
          dir="ltr"
          class="flex snap-x snap-mandatory overflow-x-auto scroll-smooth rounded-2xl"
        >
          {shots.map((s) => (
            <div class="gh-slide aspect-[4/5] w-full shrink-0 snap-center overflow-hidden">
              <img
                src={s.src}
                alt={s.caption}
                width="900"
                height="1125"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
            </div>
          ))}
        </div>

        <!-- חץ הקודם (בצד ימין) -->
        <button
          id="gh-prev"
          type="button"
          aria-label="התמונה הקודמת"
          class="absolute start-2 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-ink/50 text-cream backdrop-blur transition-colors hover:bg-ink/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold"
        >
          <svg viewBox="0 0 20 20" width="22" height="22" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.7 4.3a1 1 0 011.4 0l5 5a1 1 0 010 1.4l-5 5a1 1 0 11-1.4-1.4L12 10 7.7 5.7a1 1 0 010-1.4z" clip-rule="evenodd" /></svg>
        </button>

        <!-- חץ הבא (בצד שמאל) -->
        <button
          id="gh-next"
          type="button"
          aria-label="התמונה הבאה"
          class="absolute end-2 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-ink/50 text-cream backdrop-blur transition-colors hover:bg-ink/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold"
        >
          <svg viewBox="0 0 20 20" width="22" height="22" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12.3 4.3a1 1 0 010 1.4L8 10l4.3 4.3a1 1 0 11-1.4 1.4l-5-5a1 1 0 010-1.4l5-5a1 1 0 011.4 0z" clip-rule="evenodd" /></svg>
        </button>
      </div>

      <figcaption id="gh-cap" aria-live="polite" class="mt-3 text-center text-sm text-ink/70">
        {shots[0].caption}
      </figcaption>
    </figure>

    <div id="gh-dots" class="mt-3 flex justify-center gap-1">
      {shots.map((s, i) => (
        <button type="button" data-i={i} aria-label={`תמונה ${i + 1}`} class="flex h-6 w-6 items-center justify-center rounded-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold">
          <span class="h-2.5 w-2.5 rounded-full bg-ink/20 transition-colors"></span>
        </button>
      ))}
    </div>
  </div>

  <style is:global>
    /* הסתרת פס הגלילה של הקרוסלה */
    #gh-track { scrollbar-width: none; -ms-overflow-style: none; }
    #gh-track::-webkit-scrollbar { display: none; }
  </style>

  <script is:inline define:vars={{ captions }}>
    (function () {
      var track = document.getElementById('gh-track');
      if (!track) return;
      var cap = document.getElementById('gh-cap');
      var dots = Array.prototype.slice.call(document.querySelectorAll('#gh-dots button'));
      var slides = Array.prototype.slice.call(track.querySelectorAll('.gh-slide'));
      var n = slides.length;
      var i = 0;

      function setActive(idx) {
        i = idx;
        if (cap) cap.textContent = captions[i];
        dots.forEach(function (d, k) {
          var on = k === i;
          var dot = d.firstElementChild || d;
          dot.classList.toggle('bg-gold', on);
          dot.classList.toggle('bg-ink/20', !on);
          d.setAttribute('aria-current', on ? 'true' : 'false');
        });
      }
      function scrollToIdx(idx) {
        track.scrollTo({ left: slides[idx].offsetLeft, behavior: 'smooth' });
      }

      document.getElementById('gh-prev').addEventListener('click', function () { scrollToIdx((i - 1 + n) % n); });
      document.getElementById('gh-next').addEventListener('click', function () { scrollToIdx((i + 1) % n); });
      dots.forEach(function (d, k) { d.addEventListener('click', function () { scrollToIdx(k); }); });

      // עדכון התמונה הפעילה לפי הגלילה (גם בגרירה באצבע וגם בחצים)
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting && e.intersectionRatio >= 0.6) {
              var idx = slides.indexOf(e.target);
              if (idx !== -1 && idx !== i) setActive(idx);
            }
          });
        }, { root: track, threshold: [0.6] });
        slides.forEach(function (s) { io.observe(s); });
      } else {
        var t;
        track.addEventListener('scroll', function () {
          clearTimeout(t);
          t = setTimeout(function () {
            var idx = Math.round(track.scrollLeft / track.clientWidth);
            if (idx !== i) setActive(idx);
          }, 90);
        }, { passive: true });
      }

      setActive(0);
    })();
  </script>
</section>
