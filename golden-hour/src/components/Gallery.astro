---
// סקשן 4 — גלריה
const shots = [
  { src: '/images/gallery-1.webp', caption: 'הבר, רגע לפני השקיעה' },
  { src: '/images/gallery-2.webp', caption: 'המתחם בשעת האירוע' },
  { src: '/images/gallery-3.webp', caption: 'ישיבה ואירוח לקבוצות' },
];
---

<section class="px-5 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <h2 class="text-center text-3xl font-bold leading-tight sm:text-4xl md:text-5xl">
      ככה זה נראה בשעה שבע
    </h2>

    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {shots.map((s) => (
        <figure class="group overflow-hidden rounded-2xl">
          <div class="aspect-[4/5] overflow-hidden">
            <img
              src={s.src}
              alt={s.caption}
              width="900"
              height="1125"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          <figcaption class="mt-3 text-center text-sm text-ink/70">{s.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
