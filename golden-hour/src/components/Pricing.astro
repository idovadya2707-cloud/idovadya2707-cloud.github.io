---
// סקשן 5 — בחרו את המסלול שלכם (אקורדיון, מבוסס על סגנון ה-FAQ)
const standardItems = [
  `בר פתוח מלא: בירה, יין, וויסקי, וודקה, ג'ין, ערק, קמפרי וקוקטיילים`,
  `צוות ברמנים ומלצרים`,
  `הגברה, תאורה ועמדת DJ`,
  `ריהוט מלא וצוות ניקיון`,
];

const extrasItems = [
  `פלטת פירות העונה`,
  `פלטת גבינות משובחות`,
  `פלטת ירקות טריים`,
  `פלטת מטוגנים פריכים — קובה, סיגרים, פסטלים, חומוס וטחינה`,
  `מגש פינוקים לנשנוש — זיתים, מלפפונים, פלפל שפקה וכרוב, נאצ'וס וקרקרים`,
  `תחנת טאבון חיה — פיצות ופוקאצ'ות באפייה במקום`,
];

const Check = `<svg class="mt-1 h-5 w-5 shrink-0 text-gold-light" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 111.4-1.4l3.3 3.3 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd" /></svg>`;
---

<section class="bg-ink px-5 py-20 text-cream sm:py-28">
  <div class="mx-auto max-w-3xl">
    <h2 class="text-center text-3xl font-bold leading-tight sm:text-4xl md:text-5xl">
      מה כלול ומה אפשר להוסיף
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-center text-lg leading-relaxed text-cream/80">
      מחיר אחד וברור לאדם, בלי הפתעות. משם מוסיפים רק את מה שבא לכם.
    </p>

    <div class="mt-12 divide-y divide-gold/30 border-y border-gold/30">
      <!-- מסלול סטנדרטי (עם מחיר) -->
      <details class="group py-2">
        <summary class="flex cursor-pointer items-center justify-between gap-4 py-4">
          <span class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class="text-lg font-bold sm:text-xl">מסלול סטנדרטי</span>
            <span class="font-bold text-gold-light"><span dir="ltr">150&nbsp;₪</span> לאדם</span>
          </span>
          <svg class="faq-chevron h-5 w-5 shrink-0 text-gold-light transition-transform duration-200" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.3 7.3a1 1 0 011.4 0L10 10.6l3.3-3.3a1 1 0 111.4 1.4l-4 4a1 1 0 01-1.4 0l-4-4a1 1 0 010-1.4z" clip-rule="evenodd" />
          </svg>
        </summary>
        <ul class="space-y-2.5 pb-5">
          {standardItems.map((item) => (
            <li class="flex items-start gap-3">
              <Fragment set:html={Check} />
              <span class="text-base leading-relaxed text-cream/85 sm:text-lg">
                {item.includes('DJ')
                  ? (<>{item.split('DJ')[0]}<span dir="ltr">DJ</span>{item.split('DJ')[1]}</>)
                  : item}
              </span>
            </li>
          ))}
        </ul>
      </details>

      <!-- תוספות (ללא מחיר, נבדל ויזואלית) -->
      <details class="group py-2">
        <summary class="flex cursor-pointer items-center justify-between gap-4 py-4">
          <span class="flex items-center gap-2.5">
            <svg class="h-6 w-6 shrink-0 text-gold-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9" opacity="0.5" /><path d="M12 8.5v7M8.5 12h7" />
            </svg>
            <span class="text-lg font-bold sm:text-xl">תוספות</span>
          </span>
          <svg class="faq-chevron h-5 w-5 shrink-0 text-gold-light transition-transform duration-200" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.3 7.3a1 1 0 011.4 0L10 10.6l3.3-3.3a1 1 0 111.4 1.4l-4 4a1 1 0 01-1.4 0l-4-4a1 1 0 010-1.4z" clip-rule="evenodd" />
          </svg>
        </summary>
        <div class="pb-5">
          <p class="mb-4 text-base leading-relaxed text-cream/80 sm:text-lg">
            אפשר לשדרג את האירוע עם התוספות הבאות. התמחור נקבע לפי כמות האורחים ואופי האירוע.
          </p>
          <ul class="space-y-2.5">
            {extrasItems.map((item) => (
              <li class="flex items-start gap-3">
                <Fragment set:html={Check} />
                <span class="text-base leading-relaxed text-cream/85 sm:text-lg">{item}</span>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-base leading-relaxed text-cream/80 sm:text-lg">
            נשמח להתאים לכם את התוספות בשיחה.
          </p>
        </div>
      </details>
    </div>

    <p class="mt-6 text-center text-sm text-cream/70">
      המחיר כולל מע"מ. מינימום 50 איש.
    </p>
  </div>
</section>
