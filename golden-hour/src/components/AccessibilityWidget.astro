---
// תפריט נגישות מובנה — ללא תלות חיצונית. שומר העדפות ב-localStorage.
---

<div class="a11y-root fixed bottom-20 z-50 end-4 md:bottom-6 md:end-6 print:hidden">
  <!-- כפתור פתיחה -->
  <button
    id="a11y-toggle"
    type="button"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="a11y-panel"
    aria-label="פתיחת תפריט נגישות"
    class="flex h-14 w-14 items-center justify-center rounded-full bg-gold text-cream shadow-lg ring-1 ring-black/10 transition-transform hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink"
  >
    <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor" aria-hidden="true">
      <circle cx="12" cy="3.6" r="2" />
      <path d="M20 6.5c0 .6-.4 1-1 1.1l-4.5.8v2.3l3.2 6.9c.3.6 0 1.3-.6 1.6-.6.3-1.3 0-1.6-.6L12 13.9l-2.9 6.7c-.3.6-1 .9-1.6.6-.6-.3-.9-1-.6-1.6l3.2-6.9V8.4L5.6 7.6C5 7.5 4.6 7 4.6 6.4c0-.7.6-1.2 1.3-1.1L11 6.2c.7.1 1.3.1 2 0l5.1-.9c.6-.1 1.2.3 1.3.9 0 .1.6.4.6.4z" />
    </svg>
  </button>

  <!-- פאנל -->
  <div
    id="a11y-panel"
    role="dialog"
    aria-label="תפריט נגישות"
    aria-modal="false"
    hidden
    class="absolute bottom-16 end-0 w-72 rounded-2xl border border-gold/40 bg-cream p-4 text-ink shadow-2xl"
  >
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-bold">נגישות</h2>
      <button id="a11y-close" type="button" aria-label="סגירת תפריט הנגישות" class="rounded-md p-1 text-ink/70 hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold">
        <svg viewBox="0 0 20 20" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M6 6l8 8M14 6l-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>

    <!-- גודל טקסט -->
    <div class="mt-4">
      <span class="text-sm font-semibold">גודל טקסט</span>
      <div class="mt-2 flex items-center gap-2">
        <button data-a11y="font-dec" type="button" class="flex-1 rounded-lg border border-gold/50 py-2 text-lg font-bold hover:bg-gold-light focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold" aria-label="הקטנת טקסט">א−</button>
        <span id="a11y-font-label" class="w-10 text-center text-sm text-ink/70" aria-live="polite">100%</span>
        <button data-a11y="font-inc" type="button" class="flex-1 rounded-lg border border-gold/50 py-2 text-lg font-bold hover:bg-gold-light focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold" aria-label="הגדלת טקסט">א+</button>
      </div>
    </div>

    <!-- מתגים -->
    <div class="mt-4 space-y-2">
      <button data-a11y="contrast" type="button" aria-pressed="false" class="a11y-opt flex w-full items-center justify-between rounded-lg border border-gold/50 px-3 py-2 text-sm font-medium hover:bg-gold-light focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold">
        <span>ניגודיות גבוהה</span><span class="a11y-state text-ink/50">כבוי</span>
      </button>
      <button data-a11y="links" type="button" aria-pressed="false" class="a11y-opt flex w-full items-center justify-between rounded-lg border border-gold/50 px-3 py-2 text-sm font-medium hover:bg-gold-light focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold">
        <span>הדגשת קישורים</span><span class="a11y-state text-ink/50">כבוי</span>
      </button>
      <button data-a11y="motion" type="button" aria-pressed="false" class="a11y-opt flex w-full items-center justify-between rounded-lg border border-gold/50 px-3 py-2 text-sm font-medium hover:bg-gold-light focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold">
        <span>עצירת אנימציות</span><span class="a11y-state text-ink/50">כבוי</span>
      </button>
      <button data-a11y="readable" type="button" aria-pressed="false" class="a11y-opt flex w-full items-center justify-between rounded-lg border border-gold/50 px-3 py-2 text-sm font-medium hover:bg-gold-light focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold">
        <span>פונט קריא</span><span class="a11y-state text-ink/50">כבוי</span>
      </button>
    </div>

    <div class="mt-4 border-t border-gold/30 pt-3">
      <a href="/accessibility" class="text-sm text-gold underline underline-offset-4 hover:text-ink">להצהרת הנגישות המלאה</a>
      <button data-a11y="reset" type="button" class="mt-3 w-full rounded-lg bg-ink py-2 text-sm font-semibold text-cream hover:bg-black focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold">איפוס הגדרות נגישות</button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var d = document.documentElement;
    var store = window.localStorage;
    var SIZES = ['100%', '112%', '125%', '140%'];
    var toggles = ['contrast', 'links', 'motion', 'readable'];

    function getFont() { return parseInt(store.getItem('a11y-font') || '0', 10) || 0; }
    function applyFont(i) {
      d.style.fontSize = i > 0 ? SIZES[i] : '';
      var label = document.getElementById('a11y-font-label');
      if (label) label.textContent = SIZES[i];
    }
    function setFont(i) {
      i = Math.max(0, Math.min(SIZES.length - 1, i));
      store.setItem('a11y-font', String(i));
      applyFont(i);
    }
    function applyToggle(key, on) {
      d.classList.toggle('a11y-' + key, on);
      var btn = document.querySelector('[data-a11y="' + key + '"]');
      if (btn) {
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        var s = btn.querySelector('.a11y-state');
        if (s) { s.textContent = on ? 'פועל' : 'כבוי'; s.classList.toggle('text-gold', on); }
      }
    }
    function setToggle(key, on) {
      store.setItem('a11y-' + key, on ? '1' : '0');
      applyToggle(key, on);
    }

    // סנכרון מצב ה-UI עם מה שכבר הוחל (הוחל מוקדם ב-<head>)
    applyFont(getFont());
    toggles.forEach(function (k) { applyToggle(k, store.getItem('a11y-' + k) === '1'); });

    var panel = document.getElementById('a11y-panel');
    var toggleBtn = document.getElementById('a11y-toggle');
    var closeBtn = document.getElementById('a11y-close');

    function openPanel() { panel.hidden = false; toggleBtn.setAttribute('aria-expanded', 'true'); }
    function closePanel() { panel.hidden = true; toggleBtn.setAttribute('aria-expanded', 'false'); }

    toggleBtn.addEventListener('click', function () { panel.hidden ? openPanel() : closePanel(); });
    closeBtn.addEventListener('click', function () { closePanel(); toggleBtn.focus(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !panel.hidden) { closePanel(); toggleBtn.focus(); } });
    document.addEventListener('click', function (e) {
      if (!panel.hidden && !e.target.closest('.a11y-root')) closePanel();
    });

    panel.addEventListener('click', function (e) {
      var el = e.target.closest('[data-a11y]');
      if (!el) return;
      var act = el.getAttribute('data-a11y');
      if (act === 'font-inc') setFont(getFont() + 1);
      else if (act === 'font-dec') setFont(getFont() - 1);
      else if (act === 'reset') {
        ['a11y-font'].concat(toggles.map(function (k) { return 'a11y-' + k; })).forEach(function (k) { store.removeItem(k); });
        setFont(0);
        toggles.forEach(function (k) { applyToggle(k, false); });
      } else if (toggles.indexOf(act) !== -1) {
        setToggle(act, d.classList.contains('a11y-' + act) ? false : true);
      }
    });
  })();
</script>
